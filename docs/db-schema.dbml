// ERD для dbdiagram.io: вставить файл целиком на https://dbdiagram.io/d
// Колонки показаны все. Состав jsonb-полей и допустимые значения text-полей — в docs/db-schema.md.

Project credit_cabinet {
  database_type: 'PostgreSQL'
  Note: 'Умный кредитный кабинет предпринимателя. Справочник: docs/db-schema.md'
}

// ------------------------------------------------------------ пользователи и компании

Table users {
  id text [pk, note: 'usr_<ULID>']
  full_name text [not null]
  role text [not null, note: 'CLIENT | UNDERWRITER']
  inn text [note: 'ИНН ФЛ, для проверки подписанта; у CLIENT уникален']
  persona text [note: 'описание для /auth/test-users']
  created_at timestamptz [not null]

  indexes {
    inn [unique, note: 'WHERE role = CLIENT AND inn IS NOT NULL']
  }
}

Table companies {
  id text [pk, note: 'apl_<ULID>; в API — Applicant']
  inn text [not null, unique]
  type text [not null, note: 'LEGAL_ENTITY | SOLE_PROPRIETOR']
  name text [not null]
  ogrn text
  director_inn text
  registry_status text
  registry jsonb [note: 'реквизиты из ЕГРЮЛ/ЕГРИП']
  created_at timestamptz [not null]
}

Table company_members {
  user_id text [not null, ref: > users.id]
  company_id text [not null, ref: > companies.id]
  role text [not null, note: 'RepresentativeRole: OWNER | DIRECTOR | CFO | ACCOUNTANT | FINANCE_EMPLOYEE | BANKING_EMPLOYEE | AUTHORIZED_EMPLOYEE']
  can_sign boolean [not null]

  indexes {
    (user_id, company_id) [pk]
  }
}

// ------------------------------------------------------------ заявка

Table applications {
  id text [pk, note: 'app_<ULID>']
  number text [not null, unique, note: 'A-2026-000123']
  company_id text [not null, ref: > companies.id]
  product_code text [note: 'код из products.yaml']
  created_by text [not null, ref: > users.id]
  status text [not null, note: 'ApplicationStatus']
  version int [not null, note: 'optimistic lock']
  amount bigint
  term_months int
  form jsonb [not null, note: 'ApplicationInput']
  assignee_id text [ref: > users.id]
  deadline_at timestamptz
  submitted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table application_events {
  id text [pk, note: 'evt_<ULID>, монотонный']
  application_id text [not null, ref: > applications.id]
  type text [not null]
  from_status text
  to_status text
  actor_id text [ref: > users.id, note: 'NULL — система']
  message text [note: 'NULL — событие не для клиента']
  payload jsonb [not null]
  created_at timestamptz [not null]
}

Table info_requests {
  id text [pk, note: 'ir_<ULID>']
  application_id text [not null, ref: > applications.id]
  status text [not null, note: 'OPEN | ANSWERED | CANCELLED']
  required boolean [not null]
  question jsonb [not null]
  answer jsonb
  created_at timestamptz [not null]
  answered_at timestamptz
}

// ------------------------------------------------------------ обогащение и решение

Table source_snapshots {
  id text [pk, note: 'snap_<ULID>; только вставка']
  company_id text [not null, ref: > companies.id]
  source text [not null, note: 'SourceCode']
  mode text [not null, note: 'LIVE | MOCK']
  data jsonb [not null]
  raw_sha256 text [not null]
  raw_storage_key text [not null]
  fetched_at timestamptz [not null]
  expires_at timestamptz

  indexes {
    (company_id, source, fetched_at)
  }
}

Table collection_tasks {
  id text [pk, note: 'tsk_<ULID>']
  application_id text [ref: > applications.id, note: 'NULL — задачи до заявок']
  questionnaire_id text [not null, note: 'qst_<ULID>; анкета — в applications.form']
  inn text [not null]
  document_ids "text[]" [not null, note: 'документы, пришедшие с анкетой']
  status text [not null, default: 'PENDING', note: 'PENDING | RUNNING | COMPLETED | FAILED']
  request jsonb [not null, note: 'входные данные сбора без токенов']
  secrets jsonb [note: 'токены маркетплейсов и ОФД для worker; NULL после завершения']
  skipped_sources "text[]" [not null, note: 'системы без входных данных: не опрашиваются']
  attempts smallint [not null, default: 0]
  error text
  created_at timestamptz [not null]
  started_at timestamptz
  finished_at timestamptz
  updated_at timestamptz [not null]

  Note: 'Задача на сбор по анкете; создаётся одной транзакцией с событием в outbox, выполняет worker'

  indexes {
    questionnaire_id
    (status, created_at)
    application_id
  }
}

Table outbox {
  id bigint [pk, increment]
  topic text [not null]
  key text [not null, note: 'ключ сообщения Kafka: id задачи']
  payload jsonb [not null]
  attempts int [not null, default: 0]
  last_error text
  created_at timestamptz [not null]
  published_at timestamptz [note: 'NULL — ещё не опубликовано']

  Note: 'Исходящие события для Kafka (transactional outbox), публикует outbox-publisher'

  indexes {
    (topic, id) [note: 'WHERE published_at IS NULL']
  }
}

Table raw_collections {
  id text [pk, note: 'col_<ULID>; только вставка']
  task_id text [not null, unique, ref: - collection_tasks.id, note: 'один результат на задачу']
  questionnaire_id text [not null, note: 'qst_<ULID>; анкеты пока в памяти data-collector, без FK']
  inn text [not null]
  director_inn text
  request jsonb [not null, note: 'входные данные сбора без токенов']
  sources jsonb [not null, note: 'по системе: state, reason, запросы']
  started_at timestamptz [not null]
  finished_at timestamptz [not null]
  core_banking jsonb
  fns jsonb
  bki jsonb
  compliance jsonb
  fssp jsonb
  kad jsonb
  fedresurs jsonb
  m4d jsonb
  tax_reports jsonb
  pledge_registry jsonb
  egrn jsonb
  gosuslugi jsonb
  open_banking jsonb
  marketplaces jsonb
  ofd jsonb
  zakupki jsonb
  signals jsonb
  cbr jsonb
  hh jsonb
  created_at timestamptz [not null]

  Note: 'Сырые ответы всех внешних систем по анкете: колонка на систему, NULL — данных нет'

  indexes {
    (inn, created_at)
    questionnaire_id
  }
}

Table source_runs {
  id bigint [pk, increment]
  application_id text [not null, ref: > applications.id]
  source text [not null]
  state text [not null, note: 'PENDING | RUNNING | DONE | FAILED | SKIPPED']
  mode text [note: 'LIVE | MOCK | CACHE']
  attempts smallint [not null]
  snapshot_id text [ref: > source_snapshots.id]
  error text
  finished_at timestamptz

  indexes {
    (application_id, source) [unique]
  }
}

Table decisions {
  id text [pk, note: 'dcs_<ULID>; строка на раунд рассмотрения']
  application_id text [not null, ref: > applications.id]
  grade text [note: 'A..E']
  score numeric
  max_amount bigint
  auto_outcome text [note: 'итог движка']
  outcome text [note: 'итог раунда']
  decided_by text [ref: > users.id, note: 'NULL — автоматически']
  details jsonb [not null]
  client_reasons jsonb
  comment text
  created_at timestamptz [not null]
}

Table offers {
  id text [pk, note: 'ofr_<ULID>']
  application_id text [not null, ref: > applications.id]
  kind text [not null, note: 'REQUESTED | ALTERNATIVE | RETENTION']
  status text [not null, note: 'ACTIVE | ACCEPTED | WITHDRAWN | EXPIRED']
  amount bigint [not null]
  term_months int [not null]
  rate numeric(5,2) [not null]
  monthly_payment bigint [not null]
  terms jsonb [not null]
  valid_until timestamptz [not null]
}

// ------------------------------------------------------------ документы и подписание

Table documents {
  id text [pk, note: 'doc_<ULID>']
  application_id text [not null, ref: > applications.id]
  type text [not null, note: 'DocumentType']
  file_name text [not null]
  mime_type text [not null]
  size_bytes bigint [not null]
  sha256 text [not null]
  storage_key text [not null]
  uploaded_by text [ref: > users.id, note: 'NULL — сгенерирован банком']
  info_request_id text [ref: > info_requests.id]
  signed_document_id text [ref: > documents.id, note: 'для открепленной .sig']
  recognition jsonb
  signature_state text [not null, note: 'NOT_SIGNED | PENDING | DONE | FAILED']
  signature_verdict text [note: 'вердикт последнего отчёта']
  uploaded_at timestamptz [not null]
  deleted_at timestamptz
}

Table signature_reports {
  id text [pk, note: 'sigr_<ULID>; только вставка']
  document_id text [ref: > documents.id, note: 'NULL — POST /signatures/verify']
  verdict text [not null, note: 'SignatureVerdict']
  policy text [not null, note: 'SignaturePolicy']
  policy_satisfied boolean [not null]
  trust_mode text [not null, note: 'MOCK | LIVE']
  report jsonb [not null, note: 'SignatureReport целиком']
  requested_by text [ref: > users.id]
  verified_at timestamptz [not null]
  signature_document_id text [ref: > documents.id, note: 'файл открепленной подписи; NULL — подпись внутри документа']
  document_sha256 text [note: 'sha256 проверенных байтов документа (версия); у отчётов worker\'а обязателен']
  signature_sha256 text [note: 'sha256 файла подписи']
  profile text [note: 'TEST; NULL — отчёт не от worker\'а подписи']
  integrity_status text [note: 'VERIFIED | INVALID | INDETERMINATE | NOT_REQUIRED']
  format_status text [note: 'VERIFIED | INVALID | INDETERMINATE | NOT_REQUIRED']
  certificate_status text [note: 'VERIFIED | INVALID | INDETERMINATE | NOT_REQUIRED']
  identity_status text [note: 'VERIFIED | INVALID | INDETERMINATE | NOT_REQUIRED']
  authority_status text [note: 'VERIFIED | INVALID | INDETERMINATE | NOT_REQUIRED']
  decision text [note: 'итог по правилам банка, те же значения']
  failure_reason text [note: 'причина первого непройденного этапа']
  idempotency_key text [unique, note: 'один автоматический отчёт на версию документа и подписи']
}

Table signings {
  id text [pk, note: 'sgn_<ULID>']
  application_id text [not null, ref: > applications.id]
  offer_id text [not null, ref: > offers.id]
  signer_id text [not null, ref: > users.id]
  method text [note: 'SIMPLE_CODE | QUALIFIED_SIGNATURE']
  status text [not null, note: 'AWAITING_SIGNER | SIGNED | FAILED | CANCELLED']
  code text [note: 'только mock']
  attempts_left smallint [not null]
  signed_at timestamptz
  created_at timestamptz [not null]
}

// ------------------------------------------------------------ группы (цвет на диаграмме)

TableGroup users_companies [color: #3498DB] {
  users
  companies
  company_members
}

TableGroup application [color: #27AE60] {
  applications
  application_events
  info_requests
}

TableGroup enrichment_decision [color: #E67E22] {
  source_snapshots
  source_runs
  collection_tasks
  outbox
  raw_collections
  decisions
  offers
}

TableGroup documents_signing [color: #8E44AD] {
  documents
  signature_reports
  signings
}
