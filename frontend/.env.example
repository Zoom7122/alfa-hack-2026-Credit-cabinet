# false — выключить демо-экраны MSW и запросы к отсутствующему /api/v1
VITE_API_MOCK=true
# база REST API для браузера; по умолчанию /api/v1 (тот же origin, через прокси)
VITE_API_BASE_URL=/api/v1
# адрес прокси /api для демо-контракта (живого сервиса в стеке пока нет)
API_PROXY_TARGET=http://localhost:8080
# false — ходить в живой data-collector вместо его моков MSW
VITE_COLLECTOR_MOCK=true
# куда dev-сервер проксирует /collector при VITE_COLLECTOR_MOCK=false
COLLECTOR_PROXY_TARGET=http://localhost:8081
