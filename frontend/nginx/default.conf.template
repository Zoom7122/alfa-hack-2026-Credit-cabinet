# Шаблон: образ nginx подставляет ${API_UPSTREAM} и ${NGINX_RESOLVER} при старте контейнера.
# API_UPSTREAM — только схема, хост и порт, без пути: путь запроса (/api/v1/...) передаётся как есть.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Upstream резолвится на каждый запрос, поэтому nginx стартует и без поднятого API.
    # 127.0.0.11 — DNS Docker; вне Docker задайте NGINX_RESOLVER.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};
    set $collector_upstream ${COLLECTOR_UPSTREAM};

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # WebSocket: токен передаётся в query (?token=), поэтому без access-лога
    location /api/v1/ws {
        access_log off;
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
    }

    # REST
    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        # загрузка документов — до 20 МБ по контракту
        client_max_body_size 20m;
    }

    # data-collector: /collector/api/v1/... → /api/v1/...
    # только ручки, которые нужны кабинету: swagger, /check-mock и прочее наружу не отдаём
    location ~ ^/collector(/api/v1/(auth/test-users|auth/mock-login|me|applicants|applications/[A-Za-z0-9_]+(/questionnaire)?|collections/[A-Za-z0-9_]+))$ {
        include /etc/nginx/snippets/security-headers.conf;
        rewrite ^/collector(/.*)$ $1 break;
        proxy_pass $collector_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        # анкета: до 10 файлов по 20 МБ + 2 МБ
        client_max_body_size 210m;
    }

    location /collector/ {
        include /etc/nginx/snippets/security-headers.conf;
        return 404;
    }

    # Сборка Vite кладёт файлы с хешем в имени — их можно кэшировать надолго
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Service worker MSW не кэшируем, иначе браузер держит старые моки
    location = /mockServiceWorker.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # SPA: все остальные пути отдаёт index.html, маршруты разбирает react-router
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
