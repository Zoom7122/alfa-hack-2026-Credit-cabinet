{
    "swagger": "2.0",
    "info": {
        "description": "Сбор данных о заёмщике для скоринга: анкета клиента и сырые ответы всех внешних систем (эмулятор mock-api).\nСбор асинхронный: анкета ставит задачу в очередь (outbox → Kafka), системы опрашивает worker.\nОшибки — RFC 9457 (`application/problem+json`).",
        "title": "data-collector API",
        "contact": {},
        "version": "0.2"
    },
    "basePath": "/api/v1",
    "paths": {
        "/check-mock": {
            "get": {
                "description": "Параллельно опрашивает 5 систем банка (эмулятор mock-api) и возвращает их ответы как есть.\nСекция системы, которая не ответила, — null; причина — в sources.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "internal-data"
                ],
                "summary": "Проверить данные внутренних систем банка",
                "parameters": [
                    {
                        "type": "string",
                        "example": "7701234567",
                        "description": "ИНН: 10 цифр (ЮЛ) или 12 (ИП)",
                        "name": "inn",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/InternalData"
                        }
                    },
                    "400": {
                        "description": "не передан inn",
                        "schema": {
                            "$ref": "#/definitions/Problem"
                        }
                    },
                    "422": {
                        "description": "inn не из 10 или 12 цифр",
                        "schema": {
                            "$ref": "#/definitions/Problem"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/Problem"
                        }
                    }
                }
            }
        },
        "/collections/{id}": {
            "get": {
                "description": "Задача на сбор, созданная POST /questionnaires. PENDING — ждёт worker, RUNNING — системы опрашиваются,\nCOMPLETED — сбор сохранён в raw_collections (строка raw_collection_id), FAILED — не выполнена, причина в error.\nУ COMPLETED в sources — состояние по каждой системе: DONE, PARTIAL, FAILED, SKIPPED.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "collections"
                ],
                "summary": "Состояние сбора данных по анкете",
                "parameters": [
                    {
                        "type": "string",
                        "description": "id задачи (tsk_…)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/CollectionTask"
                        }
                    },
                    "404": {
                        "description": "задачи нет",
                        "schema": {
                            "$ref": "#/definitions/Problem"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/Problem"
                        }
                    }
                }
            }
        },
        "/questionnaires": {
            "post": {
                "description": "Проверяет анкету и данные для сбора, сохраняет анкету и создаёт задачу на сбор (status=PENDING)\nвместе с событием в outbox — одной транзакцией. Publisher отправляет событие в Kafka, worker\nопрашивает все внешние системы (эмулятор mock-api) и пишет сырые ответы строкой в raw_collections.\nСостояние сбора — GET /collections/{id} (ссылка в заголовке Location).\nСистемы без нужных данных (нет согласия, токена, залога, банков) не опрашиваются: они перечислены в skipped_sources.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "questionnaires"
                ],
                "summary": "Принять анкету и поставить сбор данных о компании в очередь",
                "parameters": [
                    {
                        "description": "Анкета и данные для сбора",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/CreateQuestionnaireRequest"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/Questionnaire"
                        },
                        "headers": {
                            "Location": {
                                "type": "string",
                                "description": "/api/v1/collections/{id} — состояние задачи на сбор"
                            }
                        }
                    },
                    "400": {
                        "description": "битый JSON, нет обязательного поля (age, marital_status, children_count, inn) или неверный тип",
                        "schema": {
                            "$ref": "#/definitions/Problem"
                        }
                    },
                    "422": {
                        "description": "нарушено правило анкеты или неверный формат данных для сбора (ИНН, БИК, VIN, даты)",
                        "schema": {
                            "$ref": "#/definitions/Problem"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/Problem"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "Collateral": {
            "type": "object",
            "properties": {
                "cadastral_numbers": {
                    "description": "недвижимость → ЕГРН",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "50:21:0110203:845"
                    ]
                },
                "serials": {
                    "description": "техника → реестр залогов",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "JCB3CX2023118457"
                    ]
                },
                "vins": {
                    "description": "транспорт → реестр залогов",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "XTC652005N1498213"
                    ]
                }
            }
        },
        "CollectionSource": {
            "type": "object",
            "properties": {
                "calls": {
                    "type": "integer"
                },
                "duration_ms": {
                    "type": "integer"
                },
                "failed_calls": {
                    "type": "integer"
                },
                "reason": {
                    "type": "string"
                },
                "source": {
                    "type": "string",
                    "enum": [
                        "CORE_BANKING",
                        "FNS",
                        "BKI",
                        "COMPLIANCE",
                        "FSSP",
                        "KAD",
                        "FEDRESURS",
                        "M4D",
                        "TAX_REPORTS",
                        "PLEDGE_REGISTRY",
                        "EGRN",
                        "GOSUSLUGI",
                        "OPEN_BANKING",
                        "MARKETPLACES",
                        "OFD",
                        "ZAKUPKI",
                        "SIGNALS",
                        "CBR",
                        "HH"
                    ]
                },
                "state": {
                    "type": "string",
                    "enum": [
                        "DONE",
                        "PARTIAL",
                        "FAILED",
                        "SKIPPED"
                    ]
                }
            }
        },
        "CollectionTask": {
            "type": "object",
            "properties": {
                "attempts": {
                    "description": "сколько раз worker брал задачу",
                    "type": "integer",
                    "example": 0
                },
                "created_at": {
                    "type": "string"
                },
                "error": {
                    "description": "почему FAILED",
                    "type": "string"
                },
                "finished_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string",
                    "example": "tsk_01JB8Z5X0G6Q9T4V2W8Y3K7M1N"
                },
                "inn": {
                    "type": "string",
                    "example": "7799000012"
                },
                "questionnaire_id": {
                    "type": "string",
                    "example": "qst_01JB8Z5X0G6Q9T4V2W8Y3K7M1N"
                },
                "raw_collection_id": {
                    "type": "string",
                    "example": "col_01JB8Z5X0G6Q9T4V2W8Y3K7M1N"
                },
                "skipped_sources": {
                    "description": "Системы, для которых в анкете нет данных (согласия, токена, залога, банков): они не опрашиваются.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "EGRN",
                        "MARKETPLACES"
                    ]
                },
                "sources": {
                    "description": "только у COMPLETED: состояние по каждой системе",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/CollectionSource"
                    }
                },
                "started_at": {
                    "type": "string"
                },
                "status": {
                    "description": "PENDING — ждёт worker, RUNNING — системы опрашиваются, COMPLETED — сбор сохранён, FAILED — не выполнена.",
                    "type": "string",
                    "enum": [
                        "PENDING",
                        "RUNNING",
                        "COMPLETED",
                        "FAILED"
                    ],
                    "example": "PENDING"
                }
            }
        },
        "Consent": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "example": "CNS-2026-000781"
                },
                "scope": {
                    "description": "только у consents.tax",
                    "type": "array",
                    "items": {
