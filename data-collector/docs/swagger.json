{
    "swagger": "2.0",
    "info": {
        "description": "Сбор данных о заёмщике для скоринга: анкета клиента и данные внутренних систем банка.\nОшибки — RFC 9457 (`application/problem+json`).",
        "title": "data-collector API",
        "contact": {},
        "version": "0.1"
    },
    "basePath": "/api/v1",
    "paths": {
        "/check-mock": {
            "get": {
                "description": "Параллельно опрашивает 5 систем банка (эмулятор mock-api) и возвращает их ответы как есть.\nСекция системы, которая не ответила, — null; причина — в sources.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "internal-data"
                ],
                "summary": "Проверить данные внутренних систем банка",
                "parameters": [
                    {
                        "type": "string",
                        "example": "7701234567",
                        "description": "ИНН: 10 цифр (ЮЛ) или 12 (ИП)",
                        "name": "inn",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/InternalData"
                        }
                    },
                    "400": {
                        "description": "не передан inn",
                        "schema": {
                            "$ref": "#/definitions/Problem"
                        }
                    },
                    "422": {
                        "description": "inn не из 10 или 12 цифр",
                        "schema": {
                            "$ref": "#/definitions/Problem"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/Problem"
                        }
                    }
                }
            }
        },
        "/questionnaires": {
            "post": {
                "description": "Проверяет правила и сохраняет анкету. Возраст — полных лет, бакеты считает скоринг.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "questionnaires"
                ],
                "summary": "Принять анкету заёмщика",
                "parameters": [
                    {
                        "description": "Анкета",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/CreateQuestionnaireRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/Questionnaire"
                        }
                    },
                    "400": {
                        "description": "битый JSON, нет поля или неверный тип",
                        "schema": {
                            "$ref": "#/definitions/Problem"
                        }
                    },
                    "422": {
                        "description": "нарушено правило: возраст 18–100, статус из перечня, детей 0–20",
                        "schema": {
                            "$ref": "#/definitions/Problem"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/Problem"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "CreateQuestionnaireRequest": {
            "type": "object",
            "required": [
                "age",
                "children_count",
                "marital_status"
            ],
            "properties": {
                "age": {
                    "type": "integer",
                    "maximum": 100,
                    "minimum": 18,
                    "example": 34
                },
                "children_count": {
                    "type": "integer",
                    "maximum": 20,
                    "minimum": 0,
                    "example": 2
                },
                "marital_status": {
                    "type": "string",
                    "enum": [
                        "SINGLE",
                        "MARRIED",
                        "DIVORCED",
                        "DIVORCED_MULTIPLE"
                    ],
                    "example": "MARRIED"
                }
            }
        },
        "InternalData": {
            "type": "object",
            "properties": {
                "accounts": {
