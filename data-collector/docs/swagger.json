                "card_index": {
                    "$ref": "#/definitions/domain.CardIndexReport"
                },
                "credits": {
                    "$ref": "#/definitions/domain.CreditReport"
                },
                "inn": {
                    "type": "string"
                },
                "salary_project": {
                    "$ref": "#/definitions/domain.SalaryProjectReport"
                },
                "sources": {
                    "type": "array",
                    "items": {
