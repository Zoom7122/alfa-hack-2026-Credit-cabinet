    "IP/LE choose exactly one matching scoring branch",
    "nil versus explicit 0 and false",
    "unknown enum => 422; JSON wrong field type => 400",
    "optional military status has no scoring or routing effect",
    "physical location requires duration; verified online/mobile does not",
    "complete=true cannot replace missing B statement",
    "all form amounts have named fields; RUB/THOUSAND_RUB equal results",
    "ignore supplied score/grade/calculated-ratio hints"
  ],
  "special_denominators": [
    {
      "id": "IP_E01",
      "rule": "F ≤ 0 — подтверждённый стоп. При R = 0 отношение не рассчитывается."
    },
    {
      "id": "IP_E02",
      "rule": "F ≤ 0 — стоп. При D = 0 и F > 0 — 30 баллов."
    },
    {
      "id": "IP_E03",
      "rule": "F ≤ 0 — стоп. Учитываются долги, обслуживаемые из общего потока."
    },
    {
      "id": "IP_E04",
      "rule": "При подтверждённом Q = 0 — 25 баллов без деления."
    },
    {
      "id": "IP_E05",
      "rule": "Меньше 8 положительных месяцев — также ручное рассмотрение."
    },
    {
      "id": "IP_E06",
      "rule": "При среднем поступлении 0 отношение не рассчитывается."
    },
    {
      "id": "IP_E07",
      "rule": "Нулевая подтверждённая база: 0 баллов, сотрудник. Неизвестная база: нужны данные."
    },
    {
      "id": "IP_E08",
      "rule": "Нулевая подтверждённая база: 0 баллов, сотрудник. Неизвестная база: нужны данные."
    },
    {
      "id": "IP_E10",
      "rule": "Меньше 80%: нужны данные; итоговый балл пока не формируется."
    },
    {
      "id": "IP_E11",
      "rule": "Больше 10%: нужны данные. Больше 5% до 10% включительно: сотрудник."
    },
    {
      "id": "IP_E12",
      "rule": "Стоимость потребности = 0: 0 баллов и ручной маршрут."
    },
    {
      "id": "IP_E13",
      "rule": "R − V ≤ 0: 0 баллов, сотрудник. F ≤ 0 остаётся стопом."
    },
    {
      "id": "LE_E01",
      "rule": "Подтверждённая стр. 1500 = 0: 20 баллов без деления."
    },
    {
      "id": "LE_E02",
      "rule": "Подтверждённая стр. 1500 = 0: 15 баллов без деления."
    },
    {
      "id": "LE_E03",
      "rule": "Подтверждённая стр. 1500 = 0: 10 баллов без деления."
    },
    {
      "id": "LE_E04",
      "rule": "Активы = 0: 0 баллов, сотрудник. Капитал ≤ 0: также сотрудник."
    },
    {
      "id": "LE_E05",
      "rule": "Стр. 1600 = 0: 0 баллов и сотрудник."
    },
    {
      "id": "LE_E06",
      "rule": "Стр. 1200 = 0: 0 баллов и сотрудник, коэффициент не рассчитывается."
    },
    {
      "id": "LE_E07",
      "rule": "При прибыли от продаж ≤ 0 — 0 баллов и сотрудник; деление не выполняется."
    },
    {
      "id": "LE_E08",
      "rule": "Проценты = 0, прибыль > 0: 20 баллов. Прибыль ≤ 0: 0 баллов, сотрудник."
    },
    {
      "id": "LE_E09",
      "rule": "Обе строки долга подтверждённо равны 0: 10 баллов без деления."
    },
    {
      "id": "LE_E10",
      "rule": "Выручка = 0: 0 баллов и сотрудник."
    },
    {
      "id": "LE_E11",
      "rule": "Выручка = 0: 0 баллов и сотрудник. Прибыль от продаж ≤ 0: сотрудник."
    },
    {
      "id": "LE_E12",
      "rule": "Выручка = 0: 0 баллов и сотрудник. Убыток в обоих годах: сотрудник."
    },
