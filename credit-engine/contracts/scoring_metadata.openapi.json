{
  "openapi": "3.1.0",
  "info": {
    "title": "Credit engine running model metadata",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/models": {
      "get": {
        "operationId": "getCompiledScoringModels",
        "summary": "Compiled model catalog of this running MS1 instance",
        "responses": {
          "200": {
            "description": "Actual supported versions and SHA-256, no activation side effects",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeMetadata"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RuntimeMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format_version",
          "models"
        ],
        "properties": {
          "format_version": {
            "type": "integer",
            "const": 1
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ScoringModelMetadata"
            }
          }
        }
      },
      "ScoringModelMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "borrower_type",
          "facts_schema_version",
          "definition_sha256",
          "facts_schema_sha256",
          "uses_facts",
          "format_version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "borrower_type": {
            "type": "string",
            "enum": [
              "SOLE_PROPRIETOR",
              "LEGAL_ENTITY"
            ]
          },
          "facts_schema_version": {
            "type": "string"
          },
          "definition_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "facts_schema_sha256": {
            "type": "string",
            "pattern": "^(?:|[a-f0-9]{64})$",
            "description": "Empty when uses_facts=false; SHA-256 otherwise."
          },
          "uses_facts": {
            "type": "boolean"
          },
          "format_version": {
            "type": "integer",
            "const": 1
          }
        }
      }
    }
  }
}
