{
  "components": {
    "schemas": {
      "ExampleNamedFacts": {
        "additionalProperties": false,
        "properties": {
          "annual_contract_value_rub": {
            "description": "Fictitious example field, RUB. No score or production criterion is assigned.",
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "has_confirmed_contracts": {
            "description": "Fictitious example field. false is a known value; null is unknown.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "annual_contract_value_rub",
          "has_confirmed_contracts"
        ],
        "type": "object"
      },
      "ExampleScoringFactsResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ScoringFactsResponseEnvelope"
          },
          {
            "properties": {
              "additional_facts": {
                "$ref": "#/components/schemas/ExampleNamedFacts"
              },
              "facts_schema_version": {
                "const": "demo-facts-v1"
              },
              "model_version": {
                "enum": [
                  "ip-demo-v1",
                  "legal-demo-v1"
                ]
              }
            },
            "type": "object"
          }
        ]
      },
      "FactsBorrower": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "inn": {
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "enum": [
              "SOLE_PROPRIETOR",
              "LEGAL_ENTITY"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "inn"
        ],
        "type": "object"
      },
      "ScoringFactsRequest": {
        "additionalProperties": false,
        "properties": {
          "application_id": {
            "minLength": 1,
            "type": "string"
          },
          "borrower": {
            "$ref": "#/components/schemas/FactsBorrower"
          },
          "facts_schema_version": {
            "minLength": 1,
            "type": "string"
          },
          "model_version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "application_id",
          "borrower",
          "model_version",
          "facts_schema_version"
        ],
        "type": "object"
      },
      "ScoringFactsResponseEnvelope": {
        "additionalProperties": false,
        "properties": {
          "additional_facts": {
            "description": "Must also validate against the exact generated named schema selected by the immutable model/schema version pair. This envelope alone is not a complete business-facts schema.",
            "type": "object"
          },
          "application_id": {
            "minLength": 1,
            "type": "string"
          },
          "borrower_id": {
            "minLength": 1,
            "type": "string"
          },
          "borrower_type": {
            "enum": [
              "SOLE_PROPRIETOR",
              "LEGAL_ENTITY"
            ],
            "type": "string"
          },
          "facts_date": {
            "format": "date",
            "type": "string"
          },
          "facts_schema_version": {
            "minLength": 1,
            "type": "string"
          },
          "model_version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "application_id",
          "borrower_id",
          "borrower_type",
          "model_version",
          "facts_schema_version",
          "facts_date",
          "additional_facts"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Fictitious supplier protocol examples only. ExampleNamedFacts and demo versions are not active models. The release contracts are generated separately in ../openapi.json and ../scoring_facts.openapi.json.",
    "title": "Scoring facts supplier contract and version-selection extension",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/scoring-facts": {
      "post": {
        "description": "MS1 makes one deterministic request for the entire facts block. Identical JSON data returns identical response data including null and facts_date. Supplier aggregation is owned by the supplier.",
        "operationId": "getScoringFacts",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoringFactsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoringFactsResponseEnvelope"
                }
              }
            },
            "description": "Valid envelope plus exact generated model-specific additional_facts schema. The illustrative response schema below is only an example."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../openapi.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Supplier rejected request. MS1 maps this to technical 502; no business result."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../openapi.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Unsupported supplier version/schema or request value. MS1 maps to technical 502."
          },
          "500": {
            "description": "Supplier failure; MS1 maps to technical 502."
          }
        },
        "tags": [
          "EXTERNAL-FACTS"
        ]
      }
    }
  }
}
