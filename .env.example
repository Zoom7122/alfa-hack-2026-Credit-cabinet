# Скопируйте в .env: cp .env.example .env
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
POSTGRES_DB=credit_cabinet
# порт Postgres на хосте
POSTGRES_PORT=5432

# Скоринг и конструктор (конструктор доступен только на localhost).
CREDIT_ENGINE_PORT=8082
ADMIN_PORT=8084
# Локальный вход: admin / credit-admin. Bcrypt-хеш с $ заключайте в одинарные кавычки.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2b$12$DQvFrfYy.TTP1PGJWUDJE.yy9Pfs4Cz8EcXAWOuLYOTGlKccynG4u'
ADMIN_EVENTS_TOKEN=local-credit-engine-admin-events-token-2026
# Пусто — http://localhost с ADMIN_PORT; для другого адреса задайте точный origin.
ADMIN_PUBLIC_ORIGIN=
ADMIN_COOKIE_SECURE=false

# порт data-collector на хосте
DATA_COLLECTOR_PORT=8081
# тестовые пользователи и готовые заявки при старте data-collector (повторный запуск сохраняет изменения)
SEED_TEST_USERS=true
SEED_TEST_APPLICATIONS=true
# порт эмулятора внешних систем (mock-api) на хосте
MOCK_API_PORT=8090
# порт Kafka на хосте (внутри compose брокер — kafka:9092)
KAFKA_PORT=9094
# порт Kafka UI (топики, сообщения, consumer group) на хосте
KAFKA_UI_PORT=8086
# порт Dozzle (логи контейнеров в браузере) на хосте
DOZZLE_PORT=8888

# порт frontend на хосте
FRONTEND_PORT=3000
# true — включены демо-экраны MSW; false — только data-collector, без запросов к /api/v1
FRONTEND_API_MOCK=true
# адрес API внутри сети compose, куда nginx фронта проксирует /api: схема, хост и порт без пути
FRONTEND_API_UPSTREAM=http://api:8080
# true — ответы data-collector во фронте отдаёт MSW; false — все его запросы идут в живой data-collector
FRONTEND_COLLECTOR_MOCK=true
# адрес data-collector внутри сети compose, куда nginx фронта проксирует /collector (префикс срезается)
FRONTEND_COLLECTOR_UPSTREAM=http://data-collector:8081
